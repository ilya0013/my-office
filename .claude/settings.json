{
  "model": "sonnet",
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md",
    "**/.claude/rules/**"
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "WebFetch",
      "Write(.claude/agents/**)",
      "Edit(.claude/agents/**)",
      "Bash(python -I -X utf8 scripts/team.py:*)",
      "Bash(python3 -I -X utf8 scripts/team.py:*)",
      "Bash(python -I -X utf8 scripts/build_agents.py)",
      "Bash(python3 -I -X utf8 scripts/build_agents.py)",
      "Bash(python -X utf8 -m unittest discover tests)",
      "Bash(python3 -X utf8 -m unittest discover tests)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(credentials*)",
      "Read(secrets*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/office.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/office.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/office.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/office.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/hooks/office.sh\""
          }
        ]
      }
    ]
  }
}
